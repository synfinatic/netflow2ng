# Arguments passed to netflow2ng by /lib/systemd/system/netflow2ng.service.
#
# netflow2ng encrypts its ZMQ feed by default and needs ntopng's public key.
# Prefer the key file over the key itself: CURVE keys contain characters that
# shells and config parsers mangle.  Copy ntopng's zmq-key.pub (normally
# /var/lib/ntopng/zmq-key.pub) onto this host first.
#
#   NETFLOW2NG_ARGS="--zmq-encryption-key-file /etc/netflow2ng/ntopng-key.pub"
#
# For ntopng older than 6.7.280831, disable encryption on both sides instead:
#
#   NETFLOW2NG_ARGS="--zmq-disable-encryption"
#
NETFLOW2NG_ARGS=""
